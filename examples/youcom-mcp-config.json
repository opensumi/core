{
  "ai.native.mcp.servers": [
    {
      "name": "youcom-search",
      "type": "sse",
      "url": "https://api.you.com/mcp",
      "enabled": true,
      "transportOptions": {
        "authProvider": {
          "token": "${env:YDC_API_KEY}"
        }
      }
    },
    {
      "name": "filesystem",
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "${workspaceFolder}"],
      "enabled": true,
      "env": {}
    }
  ]
}